# Python
**/__pycache__/
*.pyc
*.nbc
*.nbi
.pytest_cache/

# Demo build
demo/node_modules/
demo/dist/

# LaTeX build products
# monograph/ holds sources only; everything xelatex emits goes to build/.
monograph/*.aux
monograph/*.log
monograph/*.out
monograph/*.toc
monograph/*.synctex.gz
monograph/*.fdb_latexmk
monograph/*.fls
monograph/*.xdv
monograph/ACTS-MCDT.pdf
monograph/ACTS-MCDT.docx
monograph/book.pdf
build/
monograph/$build/
monograph/_backup_*/
_toc_backup/
archive/

# OS
.DS_Store
Thumbs.db

# Demo scratch
demo/_*.cjs
demo/_*.mjs
demo/_*.png
demo/*.log

# Root-level scratch scripts and images (never ship)
_*.png
_*.cjs
_*.py
_*.json
!scripts/_*.py
!scripts/_polish_*.json

# QA / probe output (capture scripts write here, never ship it)
demo/src/_probe/
demo/src/_public/
scripts/_probe-*.cjs
_pdf/

# Demo capture intermediates: the frames are ~40 MB and regenerate from the
# stills/animation step, so only the encoded results are tracked.
results/figures/demo/_frames/
results/figures/demo/*.mp4

# Local Word pagination checks (generated from the submitted DOCX)
results/word_qa/
